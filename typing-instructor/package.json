{
  "name": "typing-instructor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/make-icon.mjs && vite",
    "build": "node scripts/make-icon.mjs && tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false node scripts/make-icon.mjs && vite build && electron .",
    "electron:build": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false node scripts/make-icon.mjs && tsc && vite build && electron-builder --win portable --config.win.sign=false --config.win.signAndEditExecutable=false",
    "typecheck": "tsc --noEmit",
    "make:icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.45",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  },
  "build": {
    "appId": "com.typinginstructor.app",
    "productName": "Typing Instructor",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png",
      "forceCodeSigning": false,
      "sign": false,
      "signAndEditExecutable": false
    },
    "icon": "build/icon.png"
  },
  "description": "Professional typing instructor for web and desktop.",
  "author": "Typing Instructor"
}
